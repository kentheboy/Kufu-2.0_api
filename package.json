{
  "name": "Kufu-2.0_api",
  "version": "2.0.0",
  "description": "Khufu-2.0 project API for AWS Lambda using Claudia.js",
  "dependencies": {
    "aws-serverless-express": "^3.4.0",
    "express": "^5.1.0"
  },
  "scripts": {
    "init-claudia": "claudia generate-serverless-express-proxy --express-module main",
    "start": "node local.js",
    "create-api": "claudia create --handler lambda.handler --deploy-proxy-api --region ap-northeast-1  --runtime nodejs18.x",
    "deploy": "claudia update"
  },
  "devDependencies": {
    "claudia": "^5.14.1"
  }
}
